{
  "manifest_version": 3,
  "name": "TV Time Quick Tracker",
  "short_name": "TV Time Tracker",
  "version": "1.1.0",
  "description": "Quickly track your TV shows and movies from TV Time without visiting the website",
  "minimum_chrome_version": "114",
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "https://api2.tozelabs.com/*",
    "https://search.tvtime.com/*",
    "https://msearch.tvtime.com/*",
    "https://artworks.thetvdb.com/*"
  ],
  "action": {
    "default_popup": "src/popup.html",
    "default_title": "TV Time Quick Tracker",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "background": {
    "service_worker": "src/background.js"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
